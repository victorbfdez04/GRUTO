<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="proyectovbf.views.LoginController"
      spacing="20" alignment="CENTER"
      style="-fx-padding: 40;">

    <Label text="GRUTO - Gastos Compartidos">
        <font>
            <Font name="System Bold" size="20"/>
        </font>
    </Label>

    <Label text="Iniciar Sesión" style="-fx-font-size: 14px;"/>

    <GridPane hgap="10" vgap="12" alignment="CENTER">
        <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtUsuario" promptText="Nombre de usuario"
                   GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200"/>

        <Label text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <PasswordField fx:id="txtClave" promptText="Contraseña"
                       GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Entrar" prefWidth="100" defaultButton="true" onAction="#onLogin"/>
        <Button text="Salir"  prefWidth="100" onAction="#onSalir"/>
    </HBox>

    <Label text="(Usuario por defecto: admin / admin123)" style="-fx-text-fill: gray; -fx-font-size: 11px;"/>
</VBox>
